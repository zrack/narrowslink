{
  "name": "narrowslink",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "narrowslink": "dist-cli/narrowslink.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:cli",
    "build:app": "tsc -b && vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "preview": "vite preview",
    "capture:bridge": "node scripts/capture-bridge.mjs",
    "capture:demo": "node scripts/send-demo-udp.mjs",
    "capture:demo:nmea": "node scripts/send-demo-nmea.mjs",
    "fixture:generate": "node scripts/generate-demo-session.mjs",
    "fixture:large": "node scripts/large-session-corpus.mjs",
    "verify:bundle": "npm run build:cli --silent && node dist-cli/narrowslink.mjs verify",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "node scripts/cli-smoke.mjs",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "node scripts/run-source-e2e.mjs",
    "test:e2e:headed": "npm run build && node scripts/run-source-e2e.mjs --headed",
    "release:build": "node scripts/release/build-release.mjs",
    "test:release": "playwright test --config playwright.release.config.ts",
    "release:check": "node scripts/release/check-release.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:cli && npm run test:e2e:run && npm run release:check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "fflate": "^0.8.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "6.4.3",
    "vitest": "^4.0.18"
  }
}
